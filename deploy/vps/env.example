# Copy to .env at the repo root with mode 600:
#   install -m 600 deploy/vps/env.example .env
# Fill before the first start: SECRET_KEY, ENCRYPTION_KEY_SALT, WEBHOOK_SECRET,
# FACEBOOK_WEBHOOK_VERIFY_TOKEN, DATABASE_URL, and the Meta (Facebook), Threads
# and Google app values.
# Leave empty until those apps and the alert webhook exist:
# PLATFORM_FACEBOOK_CONFIG_ID, the TikTok and Pinterest values, and
# NOTIFICATION_WEBHOOK_URL.
# deploy/vps/check-ports.sh fails while SECRET_KEY, ENCRYPTION_KEY_SALT or
# WEBHOOK_SECRET is empty or starts with change-me.

# Core. Generate SECRET_KEY and ENCRYPTION_KEY_SALT with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ENCRYPTION_KEY_SALT=
DEBUG=false
ALLOWED_HOSTS=social.metamcpserver.xyz
APP_URL=https://social.metamcpserver.xyz
# Nobody can sign up; create accounts with createsuperuser or the Django admin.
SIGNUP_MODE=closed

# Storage. Uploads live on the media_data volume; Caddy serves the public parts.
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media

# Database: the Supabase session pooler, TLS verified against the Supabase CA
# at deploy/vps/certs/supabase-ca.crt (mounted read-only at /app/certs).
# postgres://postgres.<ref>:<url-encoded password>@<pooler host>:5432/postgres?sslmode=verify-full&sslrootcert=/app/certs/supabase-ca.crt
DATABASE_URL=

# Publishing. Each publish thread holds its own Postgres connection, so these
# two plus the 4 gunicorn threads keep peak connections near 12, under the
# session pooler's 15.
PUBLISHER_MAX_CONCURRENT_POSTS=2
PUBLISHER_MAX_CONCURRENT_PLATFORM_PUBLISHES=3
PUBLISHER_PUBLISH_CONFIRM_TIMEOUT=3600

# Proxy. Caddy's fixed address on the compose network; the app trusts
# X-Forwarded-For only from it. Caddy sets that header from CF-Connecting-IP.
BB_TRUSTED_PROXIES=172.31.71.10

# Meta: Facebook, Instagram via Facebook Login, webhooks.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
PLATFORM_FACEBOOK_APP_ID=
PLATFORM_FACEBOOK_APP_SECRET=
PLATFORM_FACEBOOK_CONFIG_ID=
PLATFORM_INSTAGRAM_FACEBOOK_DM_SCOPES_ENABLED=true

# Threads: its own app id and secret, not the Facebook pair.
PLATFORM_THREADS_APP_ID=
PLATFORM_THREADS_APP_SECRET=

# Google: YouTube and Google Business.
PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=

# TikTok.
PLATFORM_TIKTOK_CLIENT_KEY=
PLATFORM_TIKTOK_CLIENT_SECRET=

# Pinterest.
PLATFORM_PINTEREST_APP_ID=
PLATFORM_PINTEREST_APP_SECRET=

# Notifications: the n8n webhook that receives alerts, and the shared secret
# that signs them (generate it like SECRET_KEY).
NOTIFICATION_WEBHOOK_URL=
WEBHOOK_SECRET=

# Browser worker: the job directory shared with social-browser-worker.
BROWSER_JOBS_DIR=/sbw-jobs
